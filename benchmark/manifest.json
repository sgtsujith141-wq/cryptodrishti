  "changelog": [
    {
      "version": "1.2.0",
      "date": "2026-09-21",
      "change": "Added expectations for the binary, certificate and container scanners, which version 1.1.0 did not cover at all.",
      "justification": "Labelled from the fixture generator in benchmark/generate.py, which states exactly which symbols are written into each binary, which key usage each certificate carries, and which file sits in which image layer. No label here was taken from CryptoDrishti's output.",
      "effect_on_score": "Adds three scanners to the measurement and, as a result, exposes defects that a source-and-config-only corpus could not see."
    },
    {
      "version": "1.1.0",
      "date": "2026-09-21",
      "change": "Added three expected findings that the 1.0.0 labelling missed.",
      "entries": [
        "config/nginx.conf:4 sha1 \u2014 DES-CBC3-SHA is, by OpenSSL suite naming, a HMAC-SHA1 suite. The digest is part of what the line permits.",
        "config/nginx.conf:4 sha384 \u2014 ECDHE-RSA-AES256-GCM-SHA384 names SHA-384 as the suite PRF and MAC.",
        "source/go/uses.go:8 md5 \u2014 Go refuses to compile an unused import, so `import \"crypto/md5\"` is evidence that MD5 is used in this file."
      ],
      "justification": "Each of these is defensible from the fixture alone, without reference to what the tool reports: they are facts about OpenSSL cipher-suite naming and about the Go language. They were omissions in the first pass of hand-labelling, found because the tool reported them and the labels did not. Labels were NOT changed in the other direction \u2014 every finding the tool produced that the corpus does not justify remains counted as a false positive, and two such defects were fixed in the detectors instead.",
      "effect_on_score": "Raises precision by removing three spurious counts. Disclosed here so the change is auditable rather than invisible."
    }
  ]
